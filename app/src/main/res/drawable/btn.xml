<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button background with a strong TV focus ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="18dp" /><solid android:color="#222636" />
            <stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="18dp" /><solid android:color="#222636" /></shape>
    </item>
    <item>
        <shape><corners android:radius="18dp" /><solid android:color="#181B27" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" /></shape>
    </item>
</selector>
