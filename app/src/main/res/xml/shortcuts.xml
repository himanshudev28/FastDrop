<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share (API 29+): dynamic shortcuts for recent devices (see Shortcuts.kt) carry this
     category and are offered as share targets for any file and for plain text. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.fastdrop.app.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.fastdrop.app.category.SHARE_TARGET" />
    </share-target>
    <share-target android:targetClass="com.fastdrop.app.MainActivity">
        <data android:mimeType="text/plain" />
        <category android:name="com.fastdrop.app.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
